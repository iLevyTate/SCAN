# Required.
OPENAI_API_KEY=your_openai_api_key_here

# Optional. Enables the web search tool. This is a SerpAPI (serpapi.com) key -- note that
# serper.dev is a different service and its keys will not work here. The old SERPER_API_KEY
# name is still accepted as an alias.
SERPAPI_API_KEY=your_serpapi_api_key_here

# Optional. Model used by each prefrontal-cortex agent. Defaults to gpt-4o.
# DLPFC_MODEL=gpt-4o
# VMPFC_MODEL=gpt-4o
# OFC_MODEL=gpt-4o
# ACC_MODEL=gpt-4o
# MPFC_MODEL=gpt-4o

# Optional. Maximum tokens per agent response. Defaults to 4000.
# MAX_TOKENS=4000

# Optional. Per-request timeout in seconds. Bounds a hung connection, not the whole run.
# REQUEST_TIMEOUT=180

# Optional. DEBUG, INFO, WARNING, ERROR or CRITICAL. Defaults to WARNING.
# LOG_LEVEL=WARNING

# Optional. crewai sends anonymous usage traces to telemetry.crewai.com. SCAN disables this
# by default; set to false to opt back in.
# DISABLE_TELEMETRY=true
